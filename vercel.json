{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/run-reminders",
      "schedule": "0 9 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
