# Copy this file to .env and fill in real values. Never commit .env!

# Gemini AI (free tier key from https://aistudio.google.com/apikey)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"

# PostgreSQL connection string (e.g. a free Aiven instance)
DATABASE_URL="postgres://user:password@host:port/dbname?sslmode=require"

# Web Push VAPID keys — generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="MY_VAPID_PUBLIC_KEY"
VAPID_PRIVATE_KEY="MY_VAPID_PRIVATE_KEY"
VAPID_SUBJECT="mailto:you@example.com"

# Shared secret so only your cron service can trigger the scheduler endpoint
CRON_SECRET="ANY_RANDOM_STRING"

# Secret used to sign login session cookies
AUTH_SECRET="ANOTHER_RANDOM_STRING"

# The URL where the app is hosted
APP_URL="http://localhost:3000"
